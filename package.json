{
  "name": "honeymoon-journal",
  "version": "1.0.0",
  "description": "European honeymoon travel journal web app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build:cloudflare": "npm test -- --run && npm run build",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "preview": "vite preview",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "picomatch": "4.0.4",
    "micromatch": {
      "picomatch": "2.3.2"
    }
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
